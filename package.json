{
  "name": "kityminder-editor-k",
  "version": "0.0.1",
  "description": "A maintained fork of the powerful mind map editor",
  "main": "electron/main.js",
  "scripts": {
    "build": "webpack build --config ./webpack.config.js",
    "watch": "webpack serve --env development",
    "electron": "electron .",
    "electron:serve": "concurrently \"npm run watch\" \"wait-on http://localhost:9000 && electron .\"",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:build": "npm run build && electron-builder",
    "obsidian:build-assets": "node scripts/build-obsidian.js",
    "obsidian:build": "npm run build && npm run obsidian:build-assets && node esbuild.config.mjs production",
    "obsidian:dev": "npm run build && npm run obsidian:build-assets && node esbuild.config.mjs"
  },
  "build": {
    "appId": "com.example.kityminder-editor-k",
    "productName": "KityMinder Editor K",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sherman-Chen/kityminder-editor-k"
  },
  "keywords": [
    "kityminder",
    "editor",
    "html5",
    "js",
    "mindmap"
  ],
  "author": "fex <fex@baidu.com>",
  "license": "GPL-2.0",
  "bugs": {
    "url": "https://github.com/Sherman-Chen/kityminder-editor-k/issues"
  },
  "homepage": "https://github.com/Sherman-Chen/kityminder-editor-k",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-class-static-block": "^7.28.6",
    "@ltspkg/types.kityminder-core": "^1.4.0-beta.2",
    "@types/angular": "^1.8.9",
    "@types/node": "^25.6.0",
    "babel-loader": "^10.1.1",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "cz-conventional-changelog": "^1.1.5",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "grunt": "~0.4.1",
    "grunt-angular-templates": "~0.5.0",
    "grunt-cli": "^1.5.0",
    "grunt-contrib-clean": "^0.5.0",
    "grunt-contrib-concat": "~0.5.0",
    "grunt-contrib-copy": "^0.5.0",
    "grunt-module-dependence": "~0.2.0",
    "grunt-ng-annotate": "^0.9.2",
    "grunt-replace": "~0.8.0",
    "jshint-stylish": "^1.0.0",
    "less": "^4.1.3",
    "less-loader": "^11.1.3",
    "load-grunt-tasks": "^3.1.0",
    "mini-css-extract-plugin": "^2.7.6",
    "ng-annotate-loader": "^0.7.0",
    "obsidian": "^1.12.3",
    "puppeteer-core": "^24.40.0",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "wait-on": "^9.0.5",
    "webpack": "^5.88.2",
    "webpack-bundle-analyzer": "^4.9.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2",
    "webpack-shell-plugin-next": "^2.3.1"
  },
  "dependencies": {
    "@angular/common": "^18.2.12",
    "@angular/compiler": "^18.2.12",
    "@angular/core": "^18.2.12",
    "@angular/forms": "^18.2.12",
    "@angular/platform-browser": "^18.2.12",
    "@angular/platform-browser-dynamic": "^18.2.12",
    "@angular/router": "^18.2.12",
    "@angular/upgrade": "^18.2.12",
    "@zip.js/zip.js": "^2.7.24",
    "angular": "~1.3.15",
    "angular-bootstrap": "^0.12.2",
    "angular-ui-codemirror": "^0.3.0",
    "assert": "^2.0.0",
    "bootstrap": "~3.3.4",
    "codemirror": "^4.13.0",
    "jquery": "^3.7.0",
    "json-diff": "^1.0.6",
    "kity": "^2.0.4",
    "kityminder-core": "git+https://github.com/Sherman-Chen/kityminder-core-k.git#master",
    "marked": "^6.0.0",
    "os-browserify": "^0.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zone.js": "^0.14.10"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
